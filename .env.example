# Housley (public) — backend environment template.
# Copy this file to .env and fill in YOUR OWN fresh values for the public app.
# Never reuse the family app's secrets or database.

PORT=4000
# MongoDB Atlas connection string — the PUBLIC app's OWN database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/housley
# Any long random string — signs the account + PIN session tokens
JWT_SECRET=change_this_to_something_long_and_random

# Groq AI API key (server-side only — the app never sees it)
# Get one at https://console.groq.com (free tier available)
GROQ_API_KEY=
# Second API key (auto-fallback when first hits rate limit)
GROQ_API_KEY_2=

# Resend email (transactional emails: password reset, welcome)
# Get one at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com

# Sentry error monitoring (server-side)
# Get one at https://sentry.io → create Node.js project → copy DSN
SENTRY_DSN=

# PostHog analytics (server-side)
# Get one at https://posthog.com → create project → copy API key
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Cloudinary (receipt image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Master PIN for the per-family factory reset (Settings → Factory reset)
FACTORY_RESET_PIN=0259

# --- ToyyibPay payment gateway (Pro subscription) ---
TOYYIBPAY_USER_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com/index.php/api
TOYYIBPAY_RETURN_URL=http://localhost:5173/pro
TOYYIBPAY_CALLBACK_URL=
ALLOW_DEV_PAYMENT=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5175,https://localhost,capacitor://localhost,http://localhost

# App version (for APK update system)
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0.0
APP_DOWNLOAD_URL=http://localhost:5176
RELEASE_NOTES=["Initial release"]

# Backup secret (for cron job / automated backups)
BACKUP_SECRET=change_this_to_a_long_random_string
